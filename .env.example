# Copy to .env.local and fill in when wiring up real live search for Trend Hunting.
# Used by src/app/api/trends/search/route.ts once it calls a real search provider
# (Bing Web Search, SerpAPI, Google Custom Search, etc.) instead of the curated
# static dataset in src/lib/signals.ts. Never commit the real value.
# SEARCH_API_KEY=

# Base de datos Postgres (Neon / Vercel Postgres) donde el admin del Dashboard de Estrategas guarda
# peer reviews, OKRs, KPIs, QA, NPS, proyectos y tableros de Jira. Sin esto los datos se quedan en
# el navegador de cada persona. Las tablas se crean solas la primera vez.
DATABASE_URL=

# Contraseña de la sección Admin del dashboard (se valida en el servidor).
ADMIN_PASSWORD=

# Secreto compartido con las automatizaciones que viven fuera de la app (Google Apps Script que lee Gmail
# para QA y la hoja de CSAT). Se envía como "Authorization: Bearer <secreto>" a /api/ingest/{qa|csat}.
INGEST_SECRET=

# Token personal de Figma (Settings → Security → Personal access tokens, permiso de solo lectura del archivo)
# para que /api/sync/figma lea las encuestas de NPS. Vercel cron lo llama a diario; FIGMA_FILE_KEY es opcional.
FIGMA_TOKEN=
# FIGMA_FILE_KEY=mRho5FbediwfbXutd2elxQ

# Opcional: si lo defines, Vercel manda "Authorization: Bearer <CRON_SECRET>" en sus cron jobs y /api/sync/figma lo acepta.
# CRON_SECRET=

# Autoevaluación: URL pública de la app para los enlaces de los correos (si no, se usa la del navegador de quien crea la encuesta).
# APP_URL=https://qa-office.vercel.app
# Envío directo de correos con Resend (https://resend.com). Sin esto los correos quedan en cola y los entrega el worker de
# Google Apps Script (scripts/apps-script/self-eval-worker.gs) desde tu cuenta. MAIL_FROM debe ser un dominio verificado en Resend.
# RESEND_API_KEY=
# MAIL_FROM=BluePixel Estrategas <estrategas@bluepixel.mx>

# Análisis del equipo con IA (pestaña «Análisis del equipo» del Cerebro). Clave de la API de Anthropic, solo en el servidor.
# Sin esto la pestaña funciona pero no puede generar el análisis. Los datos de desempeño del equipo se envían a Anthropic al generarlo.
ANTHROPIC_API_KEY=
